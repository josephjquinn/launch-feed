{
  "rewrites": [
    { "source": "/(.*)", "destination": "/" },
    {
      "source": "/multipass/api/oauth2/authorize",
      "destination": "https://jquinn-launch.usw-18.palantirfoundry.com/multipass/api/oauth2/authorize"
    },
    {
      "source": "/multipass/:path*",
      "destination": "https://jquinn-launch.usw-18.palantirfoundry.com/multipass/:path*"
    }
  ],
  "headers": [
    {
      "source": "/multipass/:path*",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, PUT, DELETE, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "X-Requested-With, Content-Type, Authorization"
        }
      ]
    }
  ]
}
