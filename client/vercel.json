{
  "rewrites": [
    { "source": "/(.*)", "destination": "/" },
    {
      "source": "/api/(.*)",
      "destination": "https://jquinn-launch.usw-18.palantirfoundry.com/api/$1"
    },
    {
      "source": "/v2/(.*)",
      "destination": "https://jquinn-launch.usw-18.palantirfoundry.com/v2/$1"
    },
    {
      "source": "/multipass/api/oauth2/authorize(.*)",
      "destination": "https://jquinn-launch.usw-18.palantirfoundry.com/multipass/api/oauth2/authorize$1"
    },
    {
      "source": "/multipass/(.*)",
      "destination": "https://jquinn-launch.usw-18.palantirfoundry.com/multipass/$1"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, PUT, DELETE, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "X-Requested-With, Content-Type, Authorization"
        }
      ]
    },
    {
      "source": "/v2/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, PUT, DELETE, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "X-Requested-With, Content-Type, Authorization"
        }
      ]
    },
    {
      "source": "/multipass/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, PUT, DELETE, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "X-Requested-With, Content-Type, Authorization"
        }
      ]
    }
  ]
}
