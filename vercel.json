{
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://jquinn-launch.usw-18.palantirfoundry.com/api/$1",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "GET, POST, PUT, DELETE, OPTIONS",
        "Access-Control-Allow-Headers": "Authorization, Content-Type, X-Requested-With"
      }
    },
    {
      "src": "/v2/(.*)",
      "dest": "https://jquinn-launch.usw-18.palantirfoundry.com/v2/$1",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "GET, POST, PUT, DELETE, OPTIONS",
        "Access-Control-Allow-Headers": "Authorization, Content-Type, X-Requested-With"
      }
    },
    {
      "src": "/multipass/(.*)",
      "dest": "https://jquinn-launch.usw-18.palantirfoundry.com/multipass/$1",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "GET, POST, PUT, DELETE, OPTIONS",
        "Access-Control-Allow-Headers": "Authorization, Content-Type, X-Requested-With"
      }
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
